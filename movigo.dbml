// ==========================================
// CASO 3: MoviGo (Transporte por Aplicación)
// UBICACIÓN: Área Urbana de Managua, Nicaragua
// ESQUEMA: OLTP 3NF / Raw Data Source (raw_staging_movigo)
// ==========================================

Table urban_zones {
  zone_id int [pk]
  zone_name varchar(100) [not null]
  district varchar(50) [not null, note: 'Distrito I, II, III, IV, V, VI, VII']
  socioeconomic_stratum varchar(20) [not null, note: 'alto, medio, popular, comercial']
  latitude decimal(9,6) [not null]
  longitude decimal(9,6) [not null]
  coverage_radius_km decimal(4,2) [not null]
  base_flag_drop_fare decimal(8,2) [not null]
}

Table quadrants {
  quadrant_id int [pk]
  zone_id int [not null, ref: > urban_zones.zone_id]
  district varchar(50) [not null, note: 'Distrito I, II, III, IV, V, VI, VII']
  quadrant_code varchar(30) [not null, unique]
  quadrant_name varchar(120) [not null]
  grid_row int [not null]
  grid_col int [not null]
  lat_min decimal(9,6) [not null]
  lat_max decimal(9,6) [not null]
  lon_min decimal(9,6) [not null]
  lon_max decimal(9,6) [not null]
  mean_altitude_masl int [not null]
  flood_risk varchar(20) [not null, note: 'bajo, medio, alto, critico']
  main_drainage_channels varchar(200) [not null]
}

Table users {
  user_id int [pk]
  name varchar(100) [not null]
  phone varchar(20) [not null]
  preferred_payment_method varchar(30) [not null, note: 'efectivo, tarjeta, billetera_digital']
  average_rating decimal(3,2) [not null]
  registration_date date [not null]
}

Table drivers {
  driver_id int [pk]
  name varchar(100) [not null]
  average_rating decimal(3,2) [not null]
  acceptance_rate_pct decimal(4,2) [not null]
  status varchar(20) [not null, note: 'activo, inactivo, en_viaje, desconectado']
}

Table vehicles {
  vehicle_id int [pk]
  driver_id int [not null, unique, ref: - drivers.driver_id]
  service_type varchar(20) [not null, note: 'movigo_estandar, movigo_comfort, movigo_moto']
  vehicle_model varchar(100) [not null]
  vehicle_year int [not null]
  license_plate varchar(20) [not null, unique]
}

Table trips {
  trip_id int [pk]
  user_id int [not null, ref: > users.user_id]
  driver_id int [ref: > drivers.driver_id]
  origin_quadrant_id int [not null, ref: > quadrants.quadrant_id]
  destination_quadrant_id int [not null, ref: > quadrants.quadrant_id]
  origin_latitude decimal(9,6) [not null]
  origin_longitude decimal(9,6) [not null]
  destination_latitude decimal(9,6) [not null]
  destination_longitude decimal(9,6) [not null]
  requested_at timestamp [not null]
  started_at timestamp
  completed_at timestamp
  distance_km decimal(6,2) [not null]
  duration_minutes decimal(6,2) [not null]
  trip_status varchar(25) [not null, note: 'completado, cancelado_usuario, cancelado_conductor, no_asignado']
}

Table trip_payments {
  payment_id int [pk]
  trip_id int [not null, unique, ref: - trips.trip_id]
  payment_method varchar(30) [not null, note: 'efectivo, tarjeta, billetera_digital']
  base_fare decimal(8,2) [not null]
  surge_multiplier decimal(4,2) [not null, note: '1.0 a 3.2x segun lluvia, hora pico y exceso de demanda']
  tip_amount decimal(8,2) [not null, default: 0.0]
  final_fare decimal(8,2) [not null]
  payment_status varchar(20) [not null, note: 'pagado, anulado']
}

Table trip_ratings {
  rating_id int [pk]
  trip_id int [not null, unique, ref: - trips.trip_id]
  user_rating decimal(3,2) [not null]
  driver_rating decimal(3,2) [not null]
}

Table trip_cancellations {
  cancellation_id int [pk]
  trip_id int [not null, unique, ref: - trips.trip_id]
  cancelled_by varchar(20) [not null, note: 'usuario, conductor']
  cancellation_reason text [not null]
  wait_time_minutes decimal(6,2) [not null]
  origin_active_requests int [not null, note: 'Demanda activa Dt en la zona de origen al momento de la solicitud']
  origin_available_drivers int [not null, note: 'Oferta de conductores disponibles St en la zona de origen']
}

Table driver_telemetry {
  telemetry_id int [pk]
  driver_id int [not null, ref: > drivers.driver_id]
  trip_id int [ref: > trips.trip_id, note: 'NULL cuando availability_status = disponible']
  quadrant_id int [not null, ref: > quadrants.quadrant_id]
  recorded_at timestamp [not null]
  latitude decimal(9,6) [not null]
  longitude decimal(9,6) [not null]
  speed_kmh decimal(5,2) [not null]
  availability_status varchar(25) [not null, note: 'disponible, ocupado, en_camino_recogida']
}

Table incentive_campaigns {
  campaign_id int [pk]
  target_zone_id int [not null, ref: > urban_zones.zone_id]
  bonus_name varchar(100) [not null]
  budget_cost_nio decimal(10,2) [not null, note: 'Costo del bono (peso en Mochila)']
  online_hours_increase decimal(10,2) [not null, note: 'Retorno operativo a maximizar']
  incentive_type varchar(30) [not null, note: 'meta_viajes, hora_pico_lluvia, zona_alta_demanda']
  start_date date [not null]
  end_date date [not null]
  status varchar(20) [not null, note: 'activa, finalizada']
}

// Ingesta horaria por cuadrante (Clima, Escorrentía de Cauces y Tráfico)
Table quadrant_weather {
  weather_id int [pk]
  quadrant_id int [not null, ref: > quadrants.quadrant_id]
  recorded_at timestamp [not null]
  date date [not null]
  hour int [not null, note: '0 a 23']
  precipitation_mm decimal(6,2) [not null]
  channel_runoff_mm decimal(6,2) [not null, note: 'Lluvia local + escorrentía acumulada desde la cuenca sur']
  temperature_c decimal(4,1) [not null]
  congestion_index decimal(4,2) [not null, note: '1.00 fluido a 3.95 colapso por aguacero y cauce desbordado']
  flooded_roads boolean [not null, default: false]
  sky_condition varchar(30) [not null, note: 'despejado, lluvia_ligera, tormenta, nublado']
}
