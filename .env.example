# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=antojitos_db
POSTGRES_USER=antojitos_user
POSTGRES_PASSWORD=antojitos_secure_password
POSTGRES_SCHEMA=raw_staging

# dlt Connection String
# postgresql://{user}:{password}@{host}:{port}/{db}
SOURCES__POSTGRES__CREDENTIALS="postgresql://antojitos_user:antojitos_secure_password@localhost:5432/antojitos_db"

# Optional Gemini API Key for dynamic live semantic enrichment
GEMINI_API_KEY=

# Mock API Configuration for Shell Scripting (ingesta.sh)
MOCK_API_PORT=8000
MOCK_API_HOST=0.0.0.0
