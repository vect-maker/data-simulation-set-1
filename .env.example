# PostgreSQL Database Configuration (Unified Multi-Case Database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=integrador_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Target PostgreSQL Schemas per Simulation:
# - Caso 1 (Antojitos Express): raw_staging
# - Caso 2 (Cooperativa El Volcán): raw_staging_volcan
# - Caso 3 (MoviGo): raw_staging_movigo

# dlt Connection Credentials
SOURCES__POSTGRES__CREDENTIALS="postgresql://postgres:postgres@localhost:5432/integrador_db"

# Optional Gemini API Key for dynamic live LLM semantic enrichment
GEMINI_API_KEY=

# Mock API Ports for Shell Scripting (ingesta.sh)
MOCK_API_PORT=8000
MOCK_VOLCAN_API_PORT=8001
MOCK_MOVIGO_API_PORT=8002
MOCK_API_HOST=0.0.0.0
